---
import { activeSpecials, formatDate, isoDate } from '../lib/pulse';

/**
 * The "pulse" — current specials, CMS-driven.
 * Build-time filtered by lib/pulse; each card ALSO carries its expiry date so a
 * small client script hides it the moment it lapses, even between deploys. If
 * everything has lapsed, the whole section removes itself.
 */
const specials = await activeSpecials();

type PulseItem = {
  kind: 'Special';
  title: string;
  description: string;
  dateLabel: string;
  expiresIso: string;
  image?: string;
  imageAlt?: string;
  sortKey: number;
};

const items: PulseItem[] = specials
  .map((s) => ({
    kind: 'Special' as const,
    title: s.data.title,
    description: s.data.description,
    dateLabel: `Through ${formatDate(s.data.end)}`,
    expiresIso: isoDate(s.data.end),
    image: s.data.image,
    imageAlt: s.data.imageAlt,
    sortKey: s.data.end.getTime(),
  }))
  .sort((a, b) => a.sortKey - b.sortKey);
---

{
  items.length > 0 && (
    <section
      class="on-deep u-grain relative overflow-hidden bg-[var(--color-bg-deep)] text-[var(--color-on-deep)]"
      data-pulse-strip
      aria-labelledby="pulse-heading"
    >
      <div class="u-stripes absolute inset-0 opacity-100" aria-hidden="true" />
      <div class="u-container u-container-wide relative py-[var(--space-3xl)]">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="u-eyebrow">Currently in orbit</p>
            <h2 id="pulse-heading" class="u-display mt-2 text-[length:var(--step-4)]">
              Summer Specials
            </h2>
          </div>
          <a href="/mobile-espresso" class="hidden font-body text-[length:var(--step--1)] font-bold uppercase tracking-[0.08em] text-[var(--color-on-deep-soft)] no-underline underline-offset-4 hover:text-[var(--white)] hover:underline sm:inline">
            Book the espresso cart &rarr;
          </a>
        </div>

        <ul class="mt-[var(--space-xl)] grid gap-[var(--space-lg)] sm:grid-cols-2 lg:grid-cols-3">
          {items.map((item) => (
            <li
              data-pulse-item
              data-expires={item.expiresIso}
              class="flex flex-col overflow-hidden rounded-[var(--radius-lg)] border-2 border-white/25 bg-white/10 text-[var(--color-ink)]"
            >
              {item.image ? (
                <img
                  src={item.image}
                  alt={item.imageAlt ?? ''}
                  loading="lazy"
                  decoding="async"
                  width="640"
                  height="360"
                  class="aspect-[16/9] w-full object-cover"
                />
              ) : (
                <div
                  class="u-dots relative flex aspect-[16/9] items-center justify-center bg-gradient-to-br from-[var(--blue-400)] to-[var(--blue-700)]"
                  aria-hidden="true"
                >
                  <span class="font-display text-[length:var(--step-3)] font-extrabold text-[var(--white)] opacity-90">
                    {item.kind === 'Special' ? '★' : '◆'}
                  </span>
                </div>
              )}
              <div class="flex flex-1 flex-col p-6">
                <div class="flex items-center gap-2">
                  <span class:list={['u-tag', item.kind === 'Special' ? 'u-tag--solid' : 'u-tag--primary']}>
                    {item.kind}
                  </span>
                </div>
                <h3 class="mt-3 font-display text-[length:var(--step-2)] font-extrabold">{item.title}</h3>
                <p class="mt-2 text-[var(--color-ink-soft)]">{item.description}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <script is:inline>
        (function () {
          var strip = document.querySelector('[data-pulse-strip]');
          if (!strip) return;
          var today = new Date();
          today.setHours(0, 0, 0, 0);
          var items = strip.querySelectorAll('[data-pulse-item]');
          var visible = 0;
          items.forEach(function (el) {
            var exp = new Date(el.getAttribute('data-expires') + 'T00:00:00');
            if (exp < today) {
              el.remove();
            } else {
              visible++;
            }
          });
          if (visible === 0) strip.remove();
        })();
      </script>
    </section>
  )
}
