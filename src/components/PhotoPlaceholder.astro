---
/**
 * Solid-blue placeholder standing in for professional photography at the correct
 * aspect ratio. NEVER a stock photo. When Azure's photo set lands, swap this for
 * Astro's <Image /> at the same ratio — the label says what shot belongs here.
 * See README "Adding photos".
 */
interface Props {
  ratio?: string; // "16/9", "4/5", "1/1"
  label?: string;
  tone?: 'light' | 'mid' | 'deep';
  class?: string;
  rounded?: boolean;
}
const {
  ratio = '4/3',
  label = 'Photo',
  tone = 'mid',
  class: className = '',
  rounded = true,
} = Astro.props;

const tones: Record<string, string> = {
  light: 'from-[var(--blue-100)] to-[var(--blue-300)] text-[var(--blue-800)]',
  mid: 'from-[var(--blue-300)] to-[var(--blue-600)] text-[var(--white)]',
  deep: 'from-[var(--blue-700)] to-[var(--blue-900)] text-[var(--blue-100)]',
};
---

<div
  class:list={[
    'relative w-full overflow-hidden bg-gradient-to-br grid place-content-center',
    tones[tone],
    rounded && 'rounded-[var(--radius-lg)]',
    className,
  ]}
  style={`aspect-ratio: ${ratio};`}
  role="img"
  aria-label={`Placeholder for ${label}`}
>
  <div class="u-dots u-dots--tight absolute inset-0 opacity-40" aria-hidden="true"></div>
  <span
    class="relative z-10 mx-4 rounded-[var(--radius-sm)] border-2 border-current px-3 py-1.5 text-center font-body text-[length:var(--step--1)] font-bold uppercase tracking-[0.12em]"
  >
    {label}
  </span>
</div>
