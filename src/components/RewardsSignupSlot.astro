---
/**
 * ============================================================================
 * SWAPPABLE REWARDS SIGNUP SLOT  —  EDIT THIS ONE FILE TO GO LIVE
 * ============================================================================
 * The loyalty vendor is not chosen yet (TBD). This component is the single,
 * clearly-marked place to drop in the real signup when it is.
 *
 * The site does NOT run its own punch-card system — tapping a phone at the
 * counter needs POS-level integration a website can't do (see brief). This slot
 * just links to, or embeds, whatever third-party program the shop signs up for.
 *
 * TO ACTIVATE, pick ONE:
 *   A) Link out  — set `signupUrl` below to the vendor's join page.
 *   B) Embed     — set `mode = 'embed'` and paste the vendor's <script>/<iframe>
 *                  into the marked block further down.
 * Until then it renders a placeholder so the page is never broken.
 * ============================================================================
 */
const signupUrl: string | null = null; // e.g. "https://vendor.com/join/waterbearer"
const mode: 'link' | 'embed' = 'link';
---

{
  mode === 'link' && signupUrl && (
    <a
      href={signupUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center gap-2 rounded-[var(--radius-sm)] bg-[var(--color-accent)] px-8 py-4 font-sans text-[var(--step-0)] font-semibold text-[var(--color-on-accent)] no-underline transition-colors duration-200 hover:bg-[var(--color-accent-hover)]"
    >
      Join the rewards program
    </a>
  )
}

{
  mode === 'embed' && (
    <div class="rewards-embed">
      {/* <!-- PASTE VENDOR EMBED (script/iframe) HERE --> */}
    </div>
  )
}

{
  /* Placeholder shown until a vendor is wired up. Safe to leave in production
     briefly; remove once signupUrl or an embed is set. */
  !(mode === 'link' && signupUrl) && mode !== 'embed' && (
    <div class="rounded-[var(--radius-md)] border border-dashed border-[var(--color-accent)] bg-[var(--color-accent-soft)] px-6 py-5 text-[var(--color-ink)]">
      <p class="font-semibold">Sign-up is almost ready.</p>
      <p class="mt-1 text-[var(--step--1)] text-[var(--color-ink-soft)]">
        Ask a barista to add you to rewards next time you're in — online sign-up
        is coming soon.
      </p>
      <p class="mt-2 text-[var(--step--1)] text-[var(--color-ink-faint)]">
        <!-- DRAFT: dev note — set signupUrl in RewardsSignupSlot.astro to activate -->
        Setup note for the owner: this button goes live the moment you add your
        rewards vendor link in <code>src/components/RewardsSignupSlot.astro</code>.
      </p>
    </div>
  )
}
