---
import { formatPrice } from '../lib/site';
import PhotoPlaceholder from './PhotoPlaceholder.astro';

interface Props {
  slug: string;
  name: string;
  origin?: string;
  roastLevel: string;
  price: number;
  tastingNotes: string[];
  heroAlt?: string;
}
const { slug, name, origin, roastLevel, price, tastingNotes, heroAlt } = Astro.props;
---

<a
  href={`/coffee/${slug}`}
  class="group block no-underline"
  data-reveal
>
  <PhotoPlaceholder ratio="4/5" label={heroAlt ?? name} />
  <div class="mt-4">
    <div class="flex items-baseline justify-between gap-3">
      <h2 class="font-serif text-[length:var(--step-2)] transition-colors duration-200 group-hover:text-[var(--color-accent-text)]">
        {name}
      </h2>
      <span class="shrink-0 font-sans text-[var(--color-ink-soft)]">{formatPrice(price)}</span>
    </div>
    <p class="mt-1 font-sans text-[length:var(--step--1)] uppercase tracking-[0.08em] text-[var(--color-ink-faint)]">
      {[origin, roastLevel].filter(Boolean).join(' · ')}
    </p>
    <p class="mt-2 font-sans text-[var(--color-ink-soft)]">{tastingNotes.join(', ')}</p>
  </div>
</a>
