---
import { site, navLinks } from '../lib/site';
import HoursBlock from './HoursBlock.astro';
const year = new Date().getFullYear();
const { address } = site;
---

<footer class="on-deep relative mt-[var(--space-4xl)] overflow-hidden bg-[var(--color-bg-deep)] text-[var(--color-on-deep)]">
  <div class="u-dots absolute inset-0 opacity-60" aria-hidden="true"></div>

  <div class="u-container u-container-wide relative py-[var(--space-3xl)]">
    <!-- Big wordmark + CTA -->
    <div class="flex flex-col items-start justify-between gap-8 border-b border-[var(--color-on-deep-line)] pb-[var(--space-2xl)] lg:flex-row lg:items-end">
      <p class="u-display max-w-[14ch] text-[length:var(--step-5)]">Come get a coffee.</p>
      <a
        href={site.square.orderUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex shrink-0 items-center gap-2 rounded-[var(--radius-sm)] bg-[var(--white)] px-8 py-4 font-body text-[length:var(--step-1)] font-bold uppercase tracking-[0.04em] text-[var(--color-ink)] no-underline transition-transform duration-200 hover:-translate-y-0.5"
      >
        Order Online
      </a>
    </div>

    <div class="mt-[var(--space-2xl)] grid gap-[var(--space-2xl)] md:grid-cols-[1.3fr_1fr_1fr]">
      <div>
        <p class="font-display text-[length:var(--step-2)] font-extrabold">{site.name}</p>
        <p class="u-measure mt-3 text-[var(--color-on-deep-soft)]">{site.tagline}</p>
        <div class="mt-5 flex gap-4">
          {
            site.social.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                class="font-body text-[length:var(--step--1)] font-bold uppercase tracking-[0.06em] text-[var(--color-on-deep-soft)] no-underline hover:text-[var(--white)]"
              >
                {s.label}
              </a>
            ))
          }
        </div>
      </div>

      <nav aria-label="Footer">
        <h2 class="u-eyebrow mb-4">Explore</h2>
        <ul class="space-y-2">
          {
            navLinks.map((link) => (
              <li>
                <a href={link.href} class="text-[var(--color-on-deep-soft)] no-underline hover:text-[var(--white)]">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 class="u-eyebrow mb-4">Visit</h2>
        <address class="space-y-1 not-italic text-[var(--color-on-deep-soft)]">
          <p>{address.street}<br />{address.city}, {address.region} {address.postalCode}</p>
          <p><a href={`tel:${site.phoneHref}`} class="no-underline hover:text-[var(--white)]">{site.phone}</a></p>
          <p><a href={`mailto:${site.email}`} class="no-underline hover:text-[var(--white)]">{site.email}</a></p>
        </address>
        <div class="mt-4 text-[var(--color-on-deep-soft)] [&_dt]:text-[var(--white)] [&_.border-b]:border-[var(--color-on-deep-line)]">
          <HoursBlock />
        </div>
      </div>
    </div>
  </div>

  <div class="relative border-t border-[var(--color-on-deep-line)]">
    <div class="u-container u-container-wide flex flex-col gap-2 py-5 text-[length:var(--step--1)] text-[var(--color-on-deep-soft)] sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} {site.name}. All rights reserved.</p>
      <p>Owned &amp; run by {site.owner} in {address.city}, {address.region}.</p>
    </div>
  </div>
</footer>
