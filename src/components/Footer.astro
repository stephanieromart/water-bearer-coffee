---
import { site, navLinks } from '../lib/site';
const year = new Date().getFullYear();
const { address } = site;
---

<footer class="mt-[var(--space-4xl)] border-t border-[var(--color-line)] bg-[var(--color-bg-sunk)]">
  <div class="u-container grid gap-[var(--space-2xl)] py-[var(--space-2xl)] md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="font-serif text-[var(--step-2)] font-medium">{site.name}</p>
      <p class="u-measure mt-3 text-[var(--color-ink-soft)]">{site.tagline}</p>
      <div class="mt-5 flex gap-4">
        {
          site.social.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[var(--step--1)] font-semibold text-[var(--color-ink-soft)] no-underline hover:text-[var(--color-accent)]"
            >
              {s.label}
            </a>
          ))
        }
      </div>
    </div>

    <nav aria-label="Footer">
      <h2 class="u-eyebrow mb-4">Explore</h2>
      <ul class="space-y-2">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-[var(--color-ink-soft)] no-underline hover:text-[var(--color-accent)]"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h2 class="u-eyebrow mb-4">Visit</h2>
      <address class="space-y-2 not-italic text-[var(--color-ink-soft)]">
        <p>{address.street}<br />{address.city}, {address.region} {address.postalCode}</p>
        <p>
          <a href={`tel:${site.phoneHref}`} class="no-underline hover:text-[var(--color-accent)]">
            {site.phone}
          </a>
        </p>
        <p>
          <a href={`mailto:${site.email}`} class="no-underline hover:text-[var(--color-accent)]">
            {site.email}
          </a>
        </p>
      </address>
    </div>
  </div>

  <div class="border-t border-[var(--color-line)]">
    <div
      class="u-container flex flex-col gap-2 py-5 text-[var(--step--1)] text-[var(--color-ink-faint)] sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} {site.name}. All rights reserved.</p>
      <p>Order online through our <a href={site.square.orderUrl} target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-[var(--color-accent)]">Square shop</a>.</p>
    </div>
  </div>
</footer>
