---
/**
 * Button / link primitive. Renders an <a> (default) or <button>.
 * Variants:
 *   cta      — loud blue fill, white text (default; the primary action)
 *   outline  — heavy ink border (use on white)
 *   deep     — white fill on deep-blue sections
 *   ghost    — accent text link with arrow
 * External links open in a new tab with safe rel — used for all Square links.
 */
interface Props {
  href?: string;
  variant?: 'cta' | 'outline' | 'deep' | 'ghost';
  external?: boolean;
  type?: 'button' | 'submit';
  size?: 'md' | 'lg';
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = 'cta',
  external = false,
  type = 'button',
  size = 'md',
  class: className = '',
  ...rest
} = Astro.props;

const sizes: Record<string, string> = {
  md: 'px-6 py-3.5 text-[length:var(--step-0)]',
  lg: 'px-8 py-4 text-[length:var(--step-1)]',
};

const base =
  'inline-flex items-center justify-center font-body font-bold leading-none ' +
  'rounded-[var(--radius-sm)] no-underline cursor-pointer ' +
  'transition-colors duration-200 [transition-timing-function:var(--ease)]';

// `.btn` (in global.css) provides the left-wipe fill + text inversion on hover.
// Each non-ghost variant sets the wipe fill/text colors as CSS vars.
const variants: Record<string, string> = {
  cta:
    'btn bg-[var(--color-cta)] text-[var(--color-on-cta)] ' +
    '[--btn-wipe:var(--color-on-light)] [--btn-wipe-text:var(--white)]',
  outline:
    'btn border-2 border-[var(--color-line-strong)] text-[var(--color-ink)] ' +
    '[--btn-wipe:var(--white)] [--btn-wipe-text:var(--color-on-light)]',
  deep:
    'btn bg-[var(--white)] text-[var(--color-on-light)] ' +
    '[--btn-wipe:var(--color-on-light)] [--btn-wipe-text:var(--white)]',
  ghost:
    'link-underline !px-0 !py-1 text-[var(--color-accent-text)]',
};

const cls = `${base} ${sizes[size]} ${variants[variant]} ${className}`;
const externalAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

{
  href ? (
    <a href={href} class={cls} {...externalAttrs} {...rest}>
      <span class="btn__label">
        <slot />
        {variant === 'ghost' && <span aria-hidden="true">&rarr;</span>}
      </span>
    </a>
  ) : (
    <button type={type} class={cls} {...rest}>
      <span class="btn__label"><slot /></span>
    </button>
  )
}
