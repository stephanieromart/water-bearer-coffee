---
import { groupedHours } from '../lib/hours';
import hoursData from '../content/settings/hours.json';
interface Props { class?: string }
const { class: className = '' } = Astro.props;
const rows = groupedHours();
const kitchenNote = (hoursData as { kitchenNote?: string }).kitchenNote;
---

<dl class:list={['space-y-2', className]}>
  {
    rows.map((h) => (
      <div class="flex items-baseline justify-between gap-4 border-b border-[var(--color-line)] pb-2">
        <dt class="font-body font-semibold">{h.label}</dt>
        <dd class:list={['font-body', h.closed ? 'text-[var(--color-ink-faint)]' : 'text-[var(--color-ink-soft)]']}>
          {h.text}
        </dd>
      </div>
    ))
  }
</dl>
{
  kitchenNote && (
    <p class="mt-3 flex items-center gap-2 text-[length:var(--step--1)] font-semibold text-[var(--color-ink-faint)]">
      <span class="u-tag u-tag--primary !py-0.5 !text-[0.7em]">Kitchen</span>
      {kitchenNote}
    </p>
  )
}
