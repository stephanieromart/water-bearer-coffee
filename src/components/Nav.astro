---
import { site, navLinks } from '../lib/site';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---

<header class="sticky top-0 z-50 border-b-2 border-[var(--color-ink)] bg-[var(--color-bg)]/95 backdrop-blur">
  <nav class="u-container u-container-wide flex items-center justify-between gap-4 py-3" aria-label="Primary">
    <a href="/" class="shrink-0 no-underline" aria-label="Water Bearer Coffee — home">
      <img
        src="/images/brand/logo-white.png"
        alt="Water Bearer Coffee"
        width="600"
        height="600"
        class="h-12 w-auto lg:h-14"
        fetchpriority="high"
      />
    </a>

    <!-- Desktop nav -->
    <div class="hidden items-center gap-7 lg:flex">
      <ul class="flex items-center gap-6">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  'font-body text-[length:var(--step--1)] font-bold uppercase tracking-[0.08em] no-underline transition-colors duration-200 hover:text-[var(--color-primary)]',
                  isActive(link.href) ? 'text-[var(--color-primary)]' : 'text-[var(--color-ink)]',
                ]}
                aria-current={isActive(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href="/shop"
        class="inline-flex items-center gap-2 rounded-[var(--radius-sm)] border-2 border-[var(--color-line-strong)] px-4 py-2 font-body text-[length:var(--step--1)] font-bold uppercase tracking-[0.06em] text-[var(--color-ink)] no-underline transition-[transform,background-color,color] duration-200 hover:-translate-y-0.5 hover:bg-[var(--white)] hover:text-[var(--color-on-light)]"
        aria-current={isActive('/shop') ? 'page' : undefined}
      >
        Shop
      </a>
      <a
        href={site.square.orderUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-[var(--radius-sm)] bg-[var(--color-cta)] px-5 py-2.5 font-body text-[length:var(--step--1)] font-bold uppercase tracking-[0.06em] text-[var(--color-on-cta)] no-underline transition-[transform,background-color] duration-200 hover:-translate-y-0.5 hover:bg-[var(--color-cta-hover)]"
      >
        Order Online
      </a>
    </div>

    <!-- Mobile: Order Online stays visible; rest behind a disclosure -->
    <div class="flex items-center gap-2 lg:hidden">
      <a
        href={site.square.orderUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-[var(--radius-sm)] bg-[var(--color-cta)] px-3.5 py-2 font-body text-[length:var(--step--1)] font-bold uppercase tracking-[0.04em] text-[var(--color-on-cta)] no-underline"
      >
        Order
      </a>
      <details class="relative [&_.chev]:open:rotate-180">
        <summary
          class="flex cursor-pointer list-none items-center gap-1.5 rounded-[var(--radius-sm)] border-2 border-[var(--color-ink)] px-3 py-2 font-body text-[length:var(--step--1)] font-bold uppercase [&::-webkit-details-marker]:hidden"
          aria-label="Open menu"
        >
          Menu
          <span class="chev transition-transform duration-200" aria-hidden="true">▾</span>
        </summary>
        <ul class="absolute right-0 top-full z-50 mt-3 w-60 rounded-[var(--radius-md)] border-2 border-[var(--color-line-strong)] bg-[var(--color-bg-deep)] p-2 shadow-xl">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class:list={[
                    'block rounded-[var(--radius-sm)] px-3 py-2.5 font-body text-[length:var(--step-0)] font-semibold no-underline hover:bg-white/10',
                    isActive(link.href) ? 'text-[var(--color-primary)]' : '',
                  ]}
                  aria-current={isActive(link.href) ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
          <li class="mt-2 border-t-2 border-[var(--color-line-strong)] pt-2">
            <a
              href="/shop"
              class="block rounded-[var(--radius-sm)] px-3 py-2.5 font-body text-[length:var(--step-0)] font-bold no-underline hover:bg-white/10"
              aria-current={isActive('/shop') ? 'page' : undefined}
            >
              Shop &rarr;
            </a>
          </li>
        </ul>
      </details>
    </div>
  </nav>
</header>
