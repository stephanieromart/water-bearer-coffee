---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { site, formatPrice } from '../lib/site';

const items = (await getCollection('pantry')).sort((a, b) => a.data.order - b.data.order);
const available = items.filter((i) => i.data.status === 'available');
const comingSoon = items.filter((i) => i.data.status === 'coming-soon');
---

<BaseLayout
  title="Pantry"
  description="Take home what we make in house — chai concentrate, syrups, and canned cold brew from Water Bearer Coffee."
>
  <section class="u-container pt-[var(--space-3xl)]">
    <p class="u-eyebrow" data-reveal>The pantry</p>
    <h1 class="mt-4 text-[length:var(--step-4)]" data-reveal data-reveal-delay="80">Take the bar home</h1>
    <p class="u-measure mt-6 text-[var(--color-ink-soft)]" data-reveal data-reveal-delay="160">
      The chai, syrups, and cold brew we make in house — bottled and canned for
      your own kitchen. A few are still in the works; add your email and we'll tell
      you the day they land.
    </p>
  </section>

  <!-- Available now -->
  {
    available.length > 0 && (
      <section class="u-container py-[var(--space-2xl)]">
        <h2 class="u-eyebrow mb-6" data-reveal>Available now</h2>
        <ul class="grid gap-[var(--space-xl)] sm:grid-cols-2 lg:grid-cols-3">
          {available.map((item) => (
            <li
              class="flex flex-col overflow-hidden rounded-[var(--radius-lg)] border border-[var(--color-line)] bg-[var(--color-surface)]"
              data-reveal
            >
              <PhotoPlaceholder ratio="1/1" label={item.data.heroAlt ?? item.data.name} rounded={false} />
              <div class="flex flex-1 flex-col p-6">
                <p class="text-[length:var(--step--1)] uppercase tracking-[0.08em] text-[var(--color-ink-faint)]">
                  {item.data.category}
                </p>
                <h3 class="mt-1 font-serif text-[length:var(--step-2)]">{item.data.name}</h3>
                <p class="mt-2 text-[length:var(--step--1)] text-[var(--color-ink-soft)]">
                  {item.data.tastingNotes.join(', ')}
                </p>
                <p class="mt-3 flex-1 text-[var(--color-ink-soft)]">{item.data.story}</p>
                <div class="mt-6 flex items-center justify-between gap-4">
                  <span class="font-serif text-[length:var(--step-2)]">{formatPrice(item.data.price)}</span>
                  <Button
                    href={item.data.squareUrl ?? site.square.baseUrl}
                    external
                    class="!px-5 !py-2.5"
                  >
                    Buy on Square
                  </Button>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- Coming soon -->
  {
    comingSoon.length > 0 && (
      <section class="border-t border-[var(--color-line)] bg-[var(--color-bg-sunk)]">
        <div class="u-container py-[var(--space-3xl)]">
          <h2 class="u-eyebrow mb-2" data-reveal>Coming soon</h2>
          <p class="u-measure mb-8 text-[var(--color-ink-soft)]" data-reveal>
            Not launched yet — but close. Get on the list for the one you want.
          </p>
          <ul class="grid gap-[var(--space-xl)] sm:grid-cols-2 lg:grid-cols-3">
            {comingSoon.map((item) => (
              <li
                class="flex flex-col overflow-hidden rounded-[var(--radius-lg)] border border-[var(--color-line)] bg-[var(--color-surface)]"
                data-reveal
              >
                <div class="relative">
                  <PhotoPlaceholder ratio="1/1" label={item.data.heroAlt ?? item.data.name} rounded={false} />
                  <span class="absolute left-4 top-4 rounded-full bg-[var(--color-ink)] px-3 py-1 text-[length:var(--step--1)] font-semibold text-[var(--color-bg)]">
                    Coming soon
                  </span>
                </div>
                <div class="flex flex-1 flex-col p-6">
                  <p class="text-[length:var(--step--1)] uppercase tracking-[0.08em] text-[var(--color-ink-faint)]">
                    {item.data.category}
                  </p>
                  <h3 class="mt-1 font-serif text-[length:var(--step-2)]">{item.data.name}</h3>
                  <p class="mt-3 flex-1 text-[var(--color-ink-soft)]">{item.data.story}</p>
                  <div class="mt-6">
                    <p class="mb-2 text-[length:var(--step--1)] font-semibold text-[var(--color-ink)]">
                      Notify me when it launches
                    </p>
                    <NewsletterForm
                      formName="pantry-notify"
                      source={`pantry:${item.id}`}
                      label=""
                      cta="Notify me"
                      compact
                    />
                  </div>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>
