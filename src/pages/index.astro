---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { site } from '../lib/site';
---

<BaseLayout>
  <section class="relative overflow-hidden">
    <div class="u-dots absolute inset-0 opacity-50" aria-hidden="true"></div>
    <div class="u-container u-container-wide relative py-[var(--space-4xl)]">
      <p class="u-eyebrow" data-reveal>{site.address.city}, {site.address.region}</p>
      <h1 class="u-display mt-4 text-[length:var(--step-6)]" data-reveal data-reveal-delay="80">
        Roasted<br />in&nbsp;house.
      </h1>
      <p class="u-measure mt-6 text-[length:var(--step-1)] text-[var(--color-ink-soft)]" data-reveal data-reveal-delay="160">
        Layout shell is up in the new maximalist blue direction. The full home page —
        hero, specials &amp; events pulse, and the three differentiators — lands in build step 3.
      </p>
      <div class="mt-8 flex flex-wrap gap-4" data-reveal data-reveal-delay="240">
        <Button href={site.square.orderUrl} external size="lg">Order Online</Button>
        <Button href="/mobile-espresso" variant="outline" size="lg">Book the cart</Button>
      </div>
    </div>
  </section>
</BaseLayout>
