---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import CoffeeCard from '../components/CoffeeCard.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';
import HoursBlock from '../components/HoursBlock.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { site, formatPrice } from '../lib/site';

const coffees = (await getCollection('coffee')).sort((a, b) => a.data.order - b.data.order);
const featured = coffees.find((c) => c.data.featured) ?? coffees[0];

const menu = (await getCollection('menu')).sort((a, b) => a.data.order - b.data.order);
// A small "current highlights" pull: a few standout house-made items.
const highlights = menu
  .flatMap((cat) => cat.data.items.map((i) => ({ ...i, category: cat.data.category })))
  .filter((i) => i.madeInHouse)
  .slice(0, 4);

const features = [
  {
    title: 'In-House Roasting',
    body: 'We roast every bean a few feet from the bar, in small weekly batches.',
  },
  {
    title: 'Everything From Scratch',
    body: 'Chai, syrups, sauces, cold brew — cooked here, never poured from a jug.',
  },
  {
    title: 'Mobile Espresso',
    body: 'The full bar on wheels, for weddings, markets, and mornings that matter.',
  },
];
---

<BaseLayout>
  <!-- HERO ------------------------------------------------------------------ -->
  <section class="relative">
    <div class="mx-auto grid max-w-[var(--container-wide)] items-center gap-8 px-[var(--space-lg)] py-[var(--space-3xl)] md:px-[var(--space-xl)] lg:grid-cols-[1.05fr_1fr] lg:py-[var(--space-4xl)]">
      <div>
        <p class="u-eyebrow" data-reveal>{site.address.city}, {site.address.region}</p>
        <h1 class="mt-5 text-[var(--step-5)]" data-reveal data-reveal-delay="80">
          Roasted in house.<br />Poured by the person<br />who roasts it.
        </h1>
        <p
          class="u-measure mt-6 text-[var(--step-1)] text-[var(--color-ink-soft)]"
          data-reveal
          data-reveal-delay="160"
        >
          An independent café and mobile espresso bar in Traverse City. The coffee
          in your cup was roasted a few feet from where it was poured — by the same
          hands that poured it.
        </p>
        <div class="mt-8 flex flex-wrap gap-4" data-reveal data-reveal-delay="240">
          <Button href="/coffee">Shop coffee</Button>
          <Button href={site.square.orderUrl} variant="outline" external>Order online</Button>
        </div>
      </div>
      <div data-reveal data-reveal-delay="160">
        <PhotoPlaceholder ratio="4/5" label="Hero: roaster at the espresso machine" />
      </div>
    </div>
  </section>

  <!-- BRAND STATEMENT -------------------------------------------------------- -->
  <section class="border-y border-[var(--color-line)] bg-[var(--color-bg-sunk)]">
    <div class="u-container py-[var(--space-3xl)]">
      <p class="u-measure mx-auto text-center font-serif text-[var(--step-3)] leading-snug" data-reveal>
        Most cafés buy their beans from someone else and their syrups from a jug.
        We roast ours in the back and cook the rest from scratch.
      </p>
    </div>
  </section>

  <!-- THREE-UP FEATURE ------------------------------------------------------- -->
  <section class="u-container py-[var(--space-3xl)]">
    <div class="grid gap-[var(--space-xl)] md:grid-cols-3">
      {
        features.map((f, i) => (
          <div data-reveal data-reveal-delay={i * 80}>
            <div class="mb-4 h-px w-12 bg-[var(--color-accent)]" />
            <h2 class="font-serif text-[var(--step-2)]">{f.title}</h2>
            <p class="mt-3 text-[var(--color-ink-soft)]">{f.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- FEATURED COFFEE -------------------------------------------------------- -->
  <section class="border-t border-[var(--color-line)]">
    <div class="u-container grid items-center gap-[var(--space-2xl)] py-[var(--space-3xl)] lg:grid-cols-2">
      <div data-reveal>
        <PhotoPlaceholder ratio="1/1" label={featured.data.heroAlt ?? featured.data.name} />
      </div>
      <div data-reveal data-reveal-delay="120">
        <p class="u-eyebrow">Featured roast</p>
        <h2 class="mt-4 text-[var(--step-4)]">{featured.data.name}</h2>
        <p class="mt-2 font-sans uppercase tracking-[0.08em] text-[var(--color-ink-faint)]">
          {[featured.data.origin, featured.data.roastLevel].filter(Boolean).join(' · ')}
        </p>
        <div class="mt-4 flex flex-wrap gap-2">
          {featured.data.tastingNotes.map((n) => (
            <span class="rounded-full bg-[var(--color-accent-soft)] px-3 py-1 text-[var(--step--1)] text-[var(--color-ink)]">
              {n}
            </span>
          ))}
        </div>
        <p class="u-measure mt-5 text-[var(--color-ink-soft)]">{featured.data.story}</p>
        <div class="mt-7 flex flex-wrap items-center gap-5">
          <Button href={`/coffee/${featured.id}`}>Read more</Button>
          <span class="font-serif text-[var(--step-2)]">{formatPrice(featured.data.price)}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- MENU HIGHLIGHT --------------------------------------------------------- -->
  <section class="border-t border-[var(--color-line)] bg-[var(--color-bg-sunk)]">
    <div class="u-container py-[var(--space-3xl)]">
      <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
        <div>
          <p class="u-eyebrow">On the bar</p>
          <h2 class="mt-3 text-[var(--step-3)]">Made-from-scratch favorites</h2>
        </div>
        <Button href="/menu" variant="ghost">See the full menu</Button>
      </div>
      <ul class="mt-[var(--space-xl)] grid gap-[var(--space-lg)] sm:grid-cols-2 lg:grid-cols-4">
        {
          highlights.map((item, i) => (
            <li
              class="rounded-[var(--radius-lg)] border border-[var(--color-line)] bg-[var(--color-surface)] p-6"
              data-reveal
              data-reveal-delay={i * 80}
            >
              <div class="flex items-baseline justify-between gap-3">
                <h3 class="font-serif text-[var(--step-1)]">{item.name}</h3>
                {item.price && (
                  <span class="shrink-0 text-[var(--color-ink-soft)]">{formatPrice(item.price)}</span>
                )}
              </div>
              <p class="mt-2 text-[var(--step--1)] text-[var(--color-ink-soft)]">{item.description}</p>
              <p class="mt-3 text-[var(--step--1)] font-semibold text-[var(--color-accent)]">
                House-made
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- LOCATION + HOURS ------------------------------------------------------- -->
  <section class="u-container py-[var(--space-3xl)]">
    <div class="grid gap-[var(--space-2xl)] lg:grid-cols-2">
      <div data-reveal>
        <p class="u-eyebrow">Find us</p>
        <h2 class="mt-3 text-[var(--step-3)]">{site.address.street}</h2>
        <p class="mt-2 text-[var(--color-ink-soft)]">
          {site.address.city}, {site.address.region} {site.address.postalCode}
        </p>
        <div class="mt-6">
          <Button href="/visit" variant="outline">Directions &amp; parking</Button>
        </div>
      </div>
      <div data-reveal data-reveal-delay="120">
        <p class="u-eyebrow mb-4">Hours</p>
        <HoursBlock />
      </div>
    </div>
  </section>

  <!-- NEWSLETTER ------------------------------------------------------------- -->
  <section class="border-t border-[var(--color-line)]">
    <div class="u-container py-[var(--space-3xl)]">
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <h2 class="text-[var(--step-3)]">Stay in the loop</h2>
        <p class="mt-3 text-[var(--color-ink-soft)]">
          New roasts, seasonal drinks, and where the cart is parked this weekend.
        </p>
        <div class="mt-6 text-left">
          <NewsletterForm formName="newsletter" source="home" label="" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
