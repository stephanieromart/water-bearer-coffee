---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="Thank you" description="Your message has been received." noindex>
  <section class="u-container flex min-h-[50vh] flex-col justify-center py-[var(--space-4xl)]">
    <p class="u-eyebrow" data-reveal>Message received</p>
    <h1 class="mt-4 text-[length:var(--step-4)]" data-reveal data-reveal-delay="80">Thanks — we've got it.</h1>
    <p class="u-measure mt-6 text-[length:var(--step-1)] text-[var(--color-ink-soft)]" data-reveal data-reveal-delay="160">
      We read every message and reply within a couple of business days. In the
      meantime, browse what we're roasting or come find us on Front Street.
    </p>
    <div class="mt-8 flex flex-wrap gap-4" data-reveal data-reveal-delay="240">
      <Button href="/coffee">See the coffee</Button>
      <Button href="/" variant="outline">Back home</Button>
    </div>
  </section>
</BaseLayout>
