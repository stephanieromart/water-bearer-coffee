---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';
import { site } from '../lib/site';

// Section order on the page. Items are grouped under these, hidden items dropped.
const CATEGORY_ORDER = ['Coffee', 'Teas', 'Smoothies', 'Food', 'Sides'] as const;
const items = (await getCollection('menu')).filter((i) => !i.data.hidden);
const categories = CATEGORY_ORDER.map((name) => ({
  data: {
    category: name,
    items: items
      .filter((i) => i.data.category === name)
      .sort((a, b) => a.data.order - b.data.order)
      .map((i) => i.data),
  },
})).filter((c) => c.data.items.length > 0);
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
---

<BaseLayout
  title="Menu"
  description="The Water Bearer café menu — espresso, house chai and syrups, smoothies, toast, breakfast, sandwiches, and wraps."
>
  <!-- HEADER ------------------------------------------------------------------ -->
  <section class="relative overflow-hidden border-b-2 border-[var(--color-ink)]">
    <div class="u-dots absolute inset-0 -z-10 opacity-50" aria-hidden="true"></div>
    <div class="u-container u-container-wide py-[var(--space-3xl)]">
      <p class="u-eyebrow" data-reveal>Café menu</p>
      <h1 class="u-display mt-4 text-[length:var(--step-5)]" data-reveal data-reveal-delay="60">On the bar today.</h1>
      <p class="u-measure mt-6 text-[length:var(--step-1)] text-[var(--color-ink-soft)]" data-reveal data-reveal-delay="140">
        Espresso roasted in house, syrups made from scratch, plus smoothies, toast, breakfast, and
        sandwiches.
      </p>

      <!-- Category quick-nav -->
      <nav class="mt-8 flex flex-wrap gap-2" aria-label="Menu sections" data-reveal data-reveal-delay="240">
        {
          categories.map((cat) => (
            <a
              href={`#${slug(cat.data.category)}`}
              class="rounded-[var(--radius-sm)] border-2 border-[var(--color-line-strong)] px-4 py-2 font-body text-[length:var(--step--1)] font-bold uppercase tracking-[0.06em] no-underline transition-colors duration-200 hover:bg-[var(--white)] hover:text-[var(--color-on-light)]"
            >
              {cat.data.category}
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  <!-- CATEGORIES -------------------------------------------------------------- -->
  {
    categories.map((cat, ci) => (
      <section
        id={slug(cat.data.category)}
        class:list={['scroll-mt-24 border-b-2 border-[var(--color-ink)]', ci % 2 === 1 && 'bg-[var(--color-bg-tint)]']}
      >
        <div class="u-container u-container-wide py-[var(--space-3xl)]">
          <div class="flex items-baseline gap-4" data-reveal>
            <span class="font-display text-[length:var(--step-4)] font-extrabold leading-none text-[var(--blue-200)]">
              {String(ci + 1).padStart(2, '0')}
            </span>
            <h2 class="u-display text-[length:var(--step-3)]">{cat.data.category}</h2>
          </div>

          <ul class="mt-[var(--space-xl)] grid gap-[var(--space-lg)] sm:grid-cols-2 lg:grid-cols-3">
            {cat.data.items.map((item, i) => (
              <li
                class="group overflow-hidden rounded-[var(--radius-lg)] border-2 border-[var(--color-ink)] bg-[var(--color-surface)]"
                data-reveal
                data-reveal-delay={(i % 3) * 80}
              >
                <div class="relative">
                  {item.image ? (
                    <img
                      src={item.image}
                      alt={item.imageAlt ?? item.name}
                      width="800"
                      height="600"
                      loading="lazy"
                      decoding="async"
                      class="aspect-[4/3] w-full object-cover"
                    />
                  ) : (
                    <PhotoPlaceholder ratio="4/3" tone="mid" label={item.name} rounded={false} />
                  )}
                </div>
                <div class="p-5">
                  <h3 class="font-display text-[length:var(--step-1)] font-extrabold">{item.name}</h3>
                  {item.description && (
                    <p class="mt-1.5 text-[length:var(--step--1)] text-[var(--color-ink-soft)]">{item.description}</p>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }

  <!-- ALTERNATIVE OPTIONS / DIETARY ------------------------------------------- -->
  <section class="border-b-2 border-[var(--color-line-strong)] bg-[var(--color-bg-tint)]">
    <div class="u-container u-container-wide py-[var(--space-2xl)]">
      <div class="max-w-[62ch]" data-reveal>
        <p class="u-eyebrow">Alternative options</p>
        <p class="mt-3 text-[length:var(--step-1)] text-[var(--color-ink-soft)]">
          We offer alternatives such as gluten-free bread and vegan menu options, and our baked
          goods come from <strong class="font-bold text-[var(--color-ink)]">Finnley's Bakery</strong>
          — cookies, muffins, and pound cake, with dairy-free and vegan options. Let us know in the
          notes if you'd like to make a substitution.
        </p>
        <p class="mt-3 text-[length:var(--step--1)] font-bold uppercase tracking-[0.04em] text-[var(--color-ink-faint)]">
          * We are not a celiac-friendly kitchen.
        </p>
      </div>
    </div>
  </section>

  <!-- ORDER + SHOP ------------------------------------------------------------ -->
  <section class="on-deep u-grain relative overflow-hidden bg-[var(--color-bg-deep)] text-[var(--color-on-deep)]">
    <div class="u-dots absolute inset-0 opacity-50" aria-hidden="true"></div>
    <div class="u-container u-container-wide relative grid items-center gap-8 py-[var(--space-3xl)] lg:grid-cols-2">
      <div data-reveal>
        <p class="u-eyebrow">Take some home</p>
        <h2 class="u-display mt-3 text-[length:var(--step-4)]">Order ahead or shop the shelf.</h2>
        <p class="u-measure mt-4 text-[length:var(--step-1)] text-[var(--color-on-deep-soft)]">
          Skip the line and order through Square — or shop merch, prepackaged teas, and bags of
          coffee to brew at home.
        </p>
      </div>
      <div class="flex flex-wrap gap-4 lg:justify-end" data-reveal data-reveal-delay="120">
        <Button href={site.square.orderUrl} variant="deep" size="lg" external>Order online</Button>
        <Button href="/shop" variant="deep" size="lg">Shop coffee &amp; gifts</Button>
      </div>
    </div>
  </section>
</BaseLayout>
