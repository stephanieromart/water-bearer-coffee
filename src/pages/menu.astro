---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { site, formatPrice } from '../lib/site';

const categories = (await getCollection('menu')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Menu"
  description="The Water Bearer café menu — espresso, brewed and cold coffee, house chai and syrups, and food made from scratch."
>
  <section class="u-container pt-[var(--space-3xl)]">
    <p class="u-eyebrow" data-reveal>Café menu</p>
    <h1 class="mt-4 text-[var(--step-4)]" data-reveal data-reveal-delay="80">On the bar today</h1>
    <p class="u-measure mt-6 text-[var(--color-ink-soft)]" data-reveal data-reveal-delay="160">
      Prices are for our shop on {site.address.street}. Items marked
      <span class="mx-1 inline-flex items-center gap-1 align-middle">
        <span aria-hidden="true" class="inline-block h-1.5 w-1.5 rounded-full bg-[var(--color-accent)]"></span>
        <span class="text-[var(--color-accent)] font-semibold">house-made</span>
      </span>
      are prepared here from scratch.
    </p>
  </section>

  <section class="u-container py-[var(--space-3xl)]">
    <div class="grid gap-[var(--space-2xl)] md:grid-cols-2">
      {
        categories.map((cat) => (
          <div data-reveal>
            <h2 class="border-b border-[var(--color-ink)] pb-3 text-[var(--step-2)]">
              {cat.data.category}
            </h2>
            <ul class="mt-5 space-y-5">
              {cat.data.items.map((item) => (
                <li class="flex items-baseline gap-3">
                  <div class="flex-1">
                    <div class="flex items-center gap-2">
                      <h3 class="font-sans text-[var(--step-0)] font-semibold text-[var(--color-ink)]">
                        {item.name}
                      </h3>
                      {item.madeInHouse && (
                        <span
                          class="inline-flex items-center gap-1 text-[var(--color-accent)]"
                          title="Made in house from scratch"
                        >
                          <span aria-hidden="true" class="inline-block h-1.5 w-1.5 rounded-full bg-[var(--color-accent)]" />
                          <span class="sr-only">Made in house</span>
                        </span>
                      )}
                    </div>
                    {item.description && (
                      <p class="mt-0.5 text-[var(--step--1)] text-[var(--color-ink-soft)]">
                        {item.description}
                      </p>
                    )}
                  </div>
                  {item.price != null && (
                    <span
                      class="shrink-0 font-sans text-[var(--color-ink-soft)] tabular-nums"
                      aria-label={`Price ${formatPrice(item.price)}`}
                    >
                      {formatPrice(item.price)}
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="border-t border-[var(--color-line)] bg-[var(--color-bg-sunk)]">
    <div class="u-container flex flex-wrap items-center justify-between gap-6 py-[var(--space-2xl)]">
      <div data-reveal>
        <h2 class="text-[var(--step-2)]">Order ahead</h2>
        <p class="mt-2 text-[var(--color-ink-soft)]">Skip the line — order and pay through Square.</p>
      </div>
      <div data-reveal data-reveal-delay="80">
        <Button href={site.square.orderUrl} external>Order online</Button>
      </div>
    </div>
  </section>
</BaseLayout>
