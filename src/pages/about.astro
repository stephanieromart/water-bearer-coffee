---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';
import about from '../content/settings/about.json';
import { site } from '../lib/site';

// Header intro comes from the About page frontmatter.
const entry = await getEntry('pages', 'about');
if (!entry) throw new Error('Missing content/pages/about.md');

// The two profiles the client named as must-haves, rendered in one shared shape.
const { owner, roaster, community } = about;
const profiles = [
  { ...owner, tone: 'mid' as const, tagLabel: 'The owner' },
  { ...roaster, tone: 'deep' as const, tagLabel: 'The roaster' },
];
---

<BaseLayout
  title="About"
  description="The people behind Water Bearer Coffee — the owner, the roaster who pulls your shots, and the Traverse City makers we build the shop around."
>
  <!-- PAGE HEADER ------------------------------------------------------------- -->
  <section class="relative overflow-hidden border-b-2 border-[var(--color-ink)]">
    <div class="u-dots absolute inset-0 -z-10 opacity-50" aria-hidden="true"></div>
    <div class="u-container u-container-wide py-[var(--space-3xl)] lg:py-[var(--space-4xl)]">
      <p class="u-eyebrow" data-reveal>Our story</p>
      <!-- DRAFT COPY - NEEDS AZURE REVIEW -->
      <h1 class="u-display mt-4 max-w-[16ch] text-[length:var(--step-5)]" data-reveal data-reveal-delay="60">
        The same hands that <span class="text-[var(--color-primary)]">roast it</span> pour it.
      </h1>
      <p class="u-measure mt-6 text-[length:var(--step-1)] text-[var(--color-ink-soft)]" data-reveal data-reveal-delay="140">
        {entry.data.intro}
      </p>
    </div>
  </section>

  <!-- STATEMENT BAND ---------------------------------------------------------- -->
  <section class="border-b-2 border-[var(--color-ink)] bg-[var(--color-bg-tint)]">
    <div class="u-container u-container-wide py-[var(--space-2xl)]">
      <!-- DRAFT COPY - NEEDS AZURE REVIEW -->
      <p class="u-display max-w-[24ch] text-[length:var(--step-3)] leading-[var(--leading-snug)]" data-reveal>
        Coffee usually splits into two worlds that never meet.
        <span class="text-[var(--color-primary)]">We put them in the same apron.</span>
      </p>
    </div>
  </section>

  <!-- THE TWO PROFILES -------------------------------------------------------- -->
  <section class="u-container u-container-wide py-[var(--space-3xl)]">
    <ol class="grid gap-[var(--space-3xl)]">
      {
        profiles.map((person, i) => (
          <li
            class="grid items-center gap-[var(--space-2xl)] lg:grid-cols-2"
            data-reveal
          >
            <div class:list={['relative', i % 2 === 1 && 'lg:order-2']}>
              {person.image ? (
                <img
                  src={person.image}
                  alt={person.imageAlt}
                  width="900"
                  height="1100"
                  loading="lazy"
                  decoding="async"
                  class="aspect-[4/5] w-full rounded-[var(--radius-lg)] border-2 border-[var(--color-ink)] object-cover"
                />
              ) : (
                <PhotoPlaceholder
                  ratio="4/5"
                  tone={person.tone}
                  label={person.imageAlt}
                  class="border-2 border-[var(--color-ink)]"
                />
              )}
              <span class="u-tag u-tag--solid absolute -top-4 left-6 shadow-lg">{person.tagLabel}</span>
            </div>

            <div>
              <h2 class="u-display text-[length:var(--step-4)]">{person.name}</h2>
              <p class="u-eyebrow mt-3">{person.role}</p>
              {/* DRAFT COPY - NEEDS AZURE REVIEW */}
              <p class="u-measure mt-5 text-[length:var(--step-1)] text-[var(--color-ink-soft)]">
                {person.bio}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- COMMUNITY --------------------------------------------------------------- -->
  <section class="on-deep u-grain relative overflow-hidden border-y-2 border-[var(--color-line-strong)] bg-[var(--color-bg-deep)] text-[var(--color-on-deep)]">
    <div class="u-dots absolute inset-0 opacity-50" aria-hidden="true"></div>
    <div class="u-container u-container-wide relative py-[var(--space-3xl)]">
      <div class="max-w-[52ch]" data-reveal>
        <p class="u-eyebrow">Locally sourced</p>
        <h2 class="u-display mt-3 text-[length:var(--step-4)]">{community.heading}</h2>
        <p class="mt-5 text-[length:var(--step-1)] text-[var(--color-on-deep-soft)]">
          {community.intro}
        </p>
      </div>

      <ul class="mt-[var(--space-2xl)] grid gap-[var(--space-lg)] sm:grid-cols-2 lg:grid-cols-3">
        {
          community.businesses.map((b, i) => (
            <li
              class="card-hover rounded-[var(--radius-lg)] border-2 border-[var(--color-on-deep-line)] bg-white/5 p-6"
              data-reveal
              data-reveal-delay={(i % 3) * 80}
            >
              <h3 class="font-display text-[length:var(--step-2)] font-extrabold">{b.name}</h3>
              <p class="mt-2 text-[var(--color-on-deep-soft)]">{b.detail}</p>
            </li>
          ))
        }
      </ul>

      {
        community.artists && community.artists.length > 0 && (
          <div class="mt-[var(--space-3xl)] border-t border-[var(--color-on-deep-line)] pt-[var(--space-2xl)]">
            <div class="max-w-[52ch]" data-reveal>
              <p class="u-eyebrow">Made by local hands</p>
              <h3 class="u-display mt-3 text-[length:var(--step-3)]">{community.artistsHeading}</h3>
              <p class="mt-4 text-[length:var(--step-1)] text-[var(--color-on-deep-soft)]">
                {community.artistsIntro}
              </p>
            </div>
            <ul class="mt-[var(--space-xl)] grid gap-[var(--space-lg)] sm:grid-cols-2">
              {community.artists.map((a, i) => (
                <li
                  class="card-hover rounded-[var(--radius-lg)] border-2 border-[var(--color-on-deep-line)] bg-white/5 p-6"
                  data-reveal
                  data-reveal-delay={i * 80}
                >
                  <h4 class="font-display text-[length:var(--step-2)] font-extrabold">{a.name}</h4>
                  <p class="mt-2 text-[var(--color-on-deep-soft)]">{a.detail}</p>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>

  <!-- CTA --------------------------------------------------------------------- -->
  <section class="border-t-2 border-[var(--color-ink)] bg-[var(--color-bg-tint)]">
    <div class="u-container u-container-wide py-[var(--space-2xl)]">
      <div class="flex flex-wrap items-center gap-4" data-reveal>
        <Button href="/menu" size="lg">See the menu</Button>
        <Button href="/visit" variant="outline" size="lg">Come visit</Button>
        <Button href={site.square.orderUrl} variant="ghost" external>Order online</Button>
      </div>
    </div>
  </section>
</BaseLayout>
