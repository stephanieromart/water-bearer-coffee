---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import PhotoPlaceholder from '../../components/PhotoPlaceholder.astro';
import { site, formatPrice } from '../../lib/site';

export async function getStaticPaths() {
  const coffees = await getCollection('coffee');
  return coffees.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const c = entry.data;
const { Content } = await render(entry);
const specs = [
  ['Origin', c.origin],
  ['Process', c.process],
  ['Roast', c.roastLevel],
  ['Bag', c.bagSize],
].filter(([, v]) => Boolean(v)) as [string, string][];
---

<BaseLayout title={c.name} description={c.story}>
  <div class="u-container py-[var(--space-2xl)]">
    <a href="/coffee" class="text-[length:var(--step--1)] text-[var(--color-ink-soft)] no-underline hover:text-[var(--color-accent-text)]">
      &larr; All coffee
    </a>
  </div>

  <section class="u-container pb-[var(--space-3xl)]">
    <div class="grid gap-[var(--space-2xl)] lg:grid-cols-2">
      <!-- Hero image -->
      <div data-reveal>
        <PhotoPlaceholder ratio="4/5" label={c.heroAlt ?? c.name} />
      </div>

      <!-- Details -->
      <div data-reveal data-reveal-delay="100">
        <p class="u-eyebrow">{c.roastLevel} roast</p>
        <h1 class="mt-3 text-[length:var(--step-4)]">{c.name}</h1>
        <p class="mt-4 font-serif text-[length:var(--step-2)] text-[var(--color-ink-soft)]">
          {formatPrice(c.price)}{c.bagSize && <span class="text-[length:var(--step-0)]"> · {c.bagSize}</span>}
        </p>

        <!-- Tasting notes as visual chips -->
        <div class="mt-6">
          <h2 class="u-eyebrow mb-3">Tasting notes</h2>
          <ul class="flex flex-wrap gap-2">
            {c.tastingNotes.map((n) => (
              <li class="rounded-full bg-[var(--color-accent-soft)] px-4 py-1.5 text-[var(--color-ink)]">
                {n}
              </li>
            ))}
          </ul>
        </div>

        <p class="u-measure mt-6 text-[length:var(--step-1)] text-[var(--color-ink-soft)]">{c.story}</p>

        <div class="mt-8">
          {
            c.squareUrl ? (
              <Button href={c.squareUrl} external>Buy on Square</Button>
            ) : (
              <Button href={site.square.baseUrl} external>Shop on Square</Button>
            )
          }
          <p class="mt-3 text-[length:var(--step--1)] text-[var(--color-ink-faint)]">
            Opens our Square shop in a new tab. Checkout is handled by Square.
          </p>
        </div>

        <!-- Spec table -->
        <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-3 border-t border-[var(--color-line)] pt-6 sm:grid-cols-4">
          {specs.map(([label, value]) => (
            <div>
              <dt class="text-[length:var(--step--1)] uppercase tracking-[0.08em] text-[var(--color-ink-faint)]">{label}</dt>
              <dd class="mt-1 text-[var(--color-ink)]">{value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- Origin story + brew guidance -->
  <section class="border-t border-[var(--color-line)] bg-[var(--color-bg-sunk)]">
    <div class="u-container grid gap-[var(--space-2xl)] py-[var(--space-3xl)] lg:grid-cols-[1.4fr_1fr]">
      <article class="prose" data-reveal>
        <h2>The story</h2>
        <Content />
      </article>
      {
        c.brewGuidance && (
          <aside data-reveal data-reveal-delay="100">
            <h2 class="text-[length:var(--step-2)]">Brew guidance</h2>
            <p class="mt-4 text-[var(--color-ink-soft)]">{c.brewGuidance}</p>
          </aside>
        )
      }
    </div>
  </section>
</BaseLayout>
