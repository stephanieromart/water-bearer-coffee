---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CoffeeCard from '../../components/CoffeeCard.astro';

const coffees = (await getCollection('coffee')).sort((a, b) => a.data.order - b.data.order);

// Build unique filter option lists from the data itself.
const roastLevels = [...new Set(coffees.map((c) => c.data.roastLevel))];
const origins = [...new Set(coffees.map((c) => c.data.origin).filter(Boolean))] as string[];
---

<BaseLayout
  title="Coffee"
  description="Small-batch coffee roasted in house in Traverse City — single origins and the Aquarius house blend, from light to dark."
>
  <section class="u-container pt-[var(--space-3xl)]">
    <p class="u-eyebrow" data-reveal>Roasted in house</p>
    <h1 class="mt-4 text-[length:var(--step-4)]" data-reveal data-reveal-delay="80">The coffee</h1>
    <p class="u-measure mt-6 text-[var(--color-ink-soft)]" data-reveal data-reveal-delay="160">
      Every bag is roasted in small weekly batches by the same person pulling shots
      on the bar. Filter by roast or origin to find your cup.
    </p>
  </section>

  <!-- Filters (progressive enhancement: without JS, all cards show) -->
  <section class="u-container pt-[var(--space-2xl)]">
    <div
      class="flex flex-col gap-4 border-b border-[var(--color-line)] pb-6 sm:flex-row sm:items-end sm:gap-8"
      data-reveal
    >
      <div class="flex flex-col gap-1.5">
        <label for="filter-roast" class="u-eyebrow">Roast level</label>
        <select
          id="filter-roast"
          class="min-w-48 rounded-[var(--radius-sm)] border border-[var(--color-line)] bg-[var(--color-surface)] px-3 py-2.5"
        >
          <option value="">All roasts</option>
          {roastLevels.map((r) => <option value={r}>{r}</option>)}
        </select>
      </div>
      <div class="flex flex-col gap-1.5">
        <label for="filter-origin" class="u-eyebrow">Origin</label>
        <select
          id="filter-origin"
          class="min-w-48 rounded-[var(--radius-sm)] border border-[var(--color-line)] bg-[var(--color-surface)] px-3 py-2.5"
        >
          <option value="">All origins</option>
          {origins.map((o) => <option value={o}>{o}</option>)}
        </select>
      </div>
      <p
        id="filter-count"
        class="text-[var(--color-ink-faint)] sm:ml-auto"
        aria-live="polite"
      >
        {coffees.length} roasts
      </p>
    </div>
  </section>

  <section class="u-container py-[var(--space-2xl)]">
    <ul
      id="coffee-grid"
      class="grid gap-[var(--space-xl)] sm:grid-cols-2 lg:grid-cols-3"
    >
      {
        coffees.map((c) => (
          <li data-roast={c.data.roastLevel} data-origin={c.data.origin ?? ''}>
            <CoffeeCard
              slug={c.id}
              name={c.data.name}
              origin={c.data.origin}
              roastLevel={c.data.roastLevel}
              price={c.data.price}
              tastingNotes={c.data.tastingNotes}
              heroAlt={c.data.heroAlt}
            />
          </li>
        ))
      }
    </ul>
    <p id="no-results" class="hidden py-[var(--space-xl)] text-center text-[var(--color-ink-soft)]">
      No roasts match those filters. <button id="clear-filters" class="underline">Clear filters</button>
    </p>
  </section>

  <script>
    const roast = document.getElementById('filter-roast') as HTMLSelectElement;
    const origin = document.getElementById('filter-origin') as HTMLSelectElement;
    const items = Array.from(document.querySelectorAll<HTMLElement>('#coffee-grid > li'));
    const count = document.getElementById('filter-count')!;
    const noResults = document.getElementById('no-results')!;
    const clearBtn = document.getElementById('clear-filters');

    function apply() {
      let visible = 0;
      for (const li of items) {
        const matchRoast = !roast.value || li.dataset.roast === roast.value;
        const matchOrigin = !origin.value || li.dataset.origin === origin.value;
        const show = matchRoast && matchOrigin;
        li.hidden = !show;
        if (show) visible++;
      }
      count.textContent = `${visible} ${visible === 1 ? 'roast' : 'roasts'}`;
      noResults.classList.toggle('hidden', visible !== 0);
    }

    roast.addEventListener('change', apply);
    origin.addEventListener('change', apply);
    clearBtn?.addEventListener('click', () => {
      roast.value = '';
      origin.value = '';
      apply();
    });
  </script>
</BaseLayout>
